# FairLab Environment Template
# Copy to .env and generate strong runtime secrets with:
#   openssl rand -hex 32

NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# PostgreSQL 16 (production)
POSTGRES_USER=fairlab_admin
POSTGRES_PASSWORD=replace_with_openssl_rand_hex_32
POSTGRES_DB=fairlab_db
DATABASE_URL=postgres://fairlab_admin:replace_with_openssl_rand_hex_32@127.0.0.1:5432/fairlab_db

# Cryptographic Signing Keys (generate via `openssl rand -hex 32`)
JWT_SECRET=replace_with_openssl_rand_hex_32
HMAC_SECRET=replace_with_openssl_rand_hex_32

# Allowed CORS Origins in Production (comma-separated, paired with credentials: true)
CORS_ORIGIN=https://fairlab.iitbhilai.ac.in

# Optional Physical Turnstile Relay Webhook (Future Hardware Integration)
RELAY_CONTROLLER_URL=http://127.0.0.1:8080/relay
